# ==============================================================================
# Verdant Clip Studio — environment variables
# ------------------------------------------------------------------------------
# Copy to `.env` (git-ignored) and fill in the keys you use:
#     cp .env.example .env
# Secrets are only read from the environment / .env. They are never written to
# source, job payloads, logs or rendered output.
# ==============================================================================

# ------------------------------------------------------------------------------
# [REQUIRED for the default provider] Google Gemini Developer API
# Used by: clipping/providers/gemini.py, clipping/engine.py (analysis + retries),
#          clipping/voiceover.py (commentary scripts)
# Get one: https://aistudio.google.com/apikey
# ------------------------------------------------------------------------------
GOOGLE_API_KEY=

# ------------------------------------------------------------------------------
# [OPTIONAL] NVIDIA NIM — alternate analysis provider (`--ai-provider nvidia`)
# Used by: clipping/providers/nvidia.py
# Get one: https://build.nvidia.com/
# ------------------------------------------------------------------------------
NVIDIA_API_KEY=

# ------------------------------------------------------------------------------
# [OPTIONAL] Pexels — contextual B-roll footage downloads
# Used by: clipping/studio/broll.py
# Without it the pipeline simply renders without B-roll.
# Get one: https://www.pexels.com/api/
# ------------------------------------------------------------------------------
PEXELS_API_KEY=

# ------------------------------------------------------------------------------
# [OPTIONAL] HuggingFace — pyannote speaker diarization
# Required for: --split-screen / --camera-switch (podcast modes)
# Used by: clipping/diarization.py
# Accept the model agreement first:
#   https://huggingface.co/pyannote/speaker-diarization-3.1
# ------------------------------------------------------------------------------
HF_TOKEN=

# ------------------------------------------------------------------------------
# Self-hosted vLLM (optional provider). Operator-controlled: the web UI cannot
# override the endpoint or key.
# Used by: clipping/providers/config.py, clipping/providers/vllm.py
# ------------------------------------------------------------------------------
VLLM_BASE_URL=http://127.0.0.1:8001
VLLM_MODEL=google/gemma-4-E2B-it-qat-w4a16-ct
VLLM_API_KEY=
VLLM_MAX_TOKENS=4096
# Optional conservative client context ceiling (does not raise the server limit)
VLLM_CONTEXT_LIMIT=
VLLM_TIMEOUT=900

# ------------------------------------------------------------------------------
# Studio / pipeline runtime
# ------------------------------------------------------------------------------
# The renderer shares FFmpeg scratch files, so API jobs must stay serial.
MAX_CONCURRENT_JOBS=1
# Where the job store snapshot is persisted (default: ./outputs/jobs.json)
OSC_JOB_STORE_PATH=
# Optional operator-provided yt-dlp cookies file for the backend
OSC_YOUTUBE_COOKIES_FILE=
# Cache dirs used by torch / mediapipe model downloads
TORCH_HOME=
XDG_CACHE_HOME=

# ------------------------------------------------------------------------------
# [OPTIONAL] Facebook Reels auto-uploader (CLI helper only)
# Used by: facebook_uploader/uploader.py when invoked directly
# ------------------------------------------------------------------------------
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_GRAPH_VERSION=v25.0
APP_TIMEZONE=Asia/Jakarta

# ------------------------------------------------------------------------------
# [OPTIONAL] Remote GPU notebooks only — public tunnel
# Used by: scripts/kaggle_studio.py (not required for local Studio)
# ------------------------------------------------------------------------------
NGROK_AUTHTOKEN=
